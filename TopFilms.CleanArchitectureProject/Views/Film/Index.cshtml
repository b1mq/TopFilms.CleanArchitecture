@model IEnumerable<TopFilms.Domain.Entities.Film>

@{
    ViewData["Title"] = "Movie Catalog";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<div class="container py-4" data-bs-theme="dark">
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 text-center">
            <h1 class="display-5 fw-bold text-white mb-3">Search and Import Films</h1>
            <p class="text-secondary mb-4">Enter a movie title in English to fetch data from the OMDb API into your local database.</p>

            <form asp-controller="Film" asp-action="GetNewFilm" method="get" class="d-flex gap-2">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-dark border-secondary text-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="title" class="form-control bg-dark text-white border-secondary" placeholder="e.g., Inception, The Matrix..." required />
                </div>
                <button type="submit" class="btn btn-primary btn-lg px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-cloud-arrow-down"></i> Import
                </button>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <h3 class="m-0 text-white"><i class="bi bi-collection-play me-2"></i>Movie Collection</h3>
        <span class="badge bg-secondary fs-6">Total: @(Model?.Count() ?? 0)</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var film in Model)
            {
                <div class="col">
                    <div class="card h-100 bg-dark text-white border-secondary shadow-sm">
                        @if (!string.IsNullOrEmpty(film.Poster_Url) && film.Poster_Url != "N/A")
                        {
                            <img src="@film.Poster_Url" class="card-img-top" alt="@film.Title" style="height: 360px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary bg-opacity-25 card-img-top d-flex align-items-center justify-content-center" style="height: 360px;">
                                <i class="bi bi-film fs-1 text-secondary"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate">@film.Title</h5>
                            <div class="d-flex justify-content-between text-secondary small mb-2">
                                <span>@(film.Release_Year?.ToString() ?? "N/A")</span>
                                <span class="text-warning"><i class="bi bi-star-fill"></i> @(film.Rating?.ToString("0.0") ?? "N/A")</span>
                            </div>
                            <p class="card-text text-secondary small flex-grow-1">
                                @(film.Description != null && film.Description.Length > 90 ? film.Description.Substring(0, 90) + "..." : film.Description)
                            </p>
                            <div class="pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
                                <span class="badge bg-outline-secondary border text-secondary text-truncate" style="max-width: 120px;">@film.Genre</span>

                                <form asp-controller="Film" asp-action="DeleteMovie" asp-route-id="@film.Film_id" method="post" onsubmit="return confirm('Delete this movie?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm border-0">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-secondary">
            <i class="bi bi-camera-reels display-1"></i>
            <p class="mt-3">There are no saved movies in your database yet.</p>
        </div>
    }
</div>